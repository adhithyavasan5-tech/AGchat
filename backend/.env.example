# Django Settings
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Database Configuration
DATABASE_URL=postgresql://postgres:your_database_password@db.your-project.supabase.co:5432/postgres

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
